# Sheraos CRM — .env.production
# Copie este arquivo pra `.env.production` na VPS Locaweb e preencha os valores.
# NUNCA commite `.env.production` no git (esta no .gitignore).
#
# Gere os secrets com:
#   openssl rand -hex 32  (JWT, EVOLUTION_API_KEY)
#   openssl rand -hex 24  (EVO_DB_PASSWORD)
#   openssl rand -hex 16  (META_VERIFY_TOKEN)

# --- Auth ---
# JWT secret proprio do Sheraos. Trocar por valor unico.
JWT_SECRET=REPLACE_ME_com_openssl_rand_hex_32

# --- URL publica ---
# Usada pra registrar webhooks Evolution apontando pro Sheraos, nao pro Dros.
PUBLIC_BASE_URL=https://sheraos.com.br/crm

# --- Bot IA (Anthropic Haiku) ---
# Chave compartilhada da agencia. Cliente Sheraos NAO ve esta chave (fica so no env do container).
# Backend usa como fallback quando conta nao tem propria chave configurada.
ANTHROPIC_API_KEY_GLOBAL=sk-ant-api03-xxxxx

# --- Evolution API (WhatsApp) ---
# URL interna do container Evolution (nao expor pra fora).
EVOLUTION_API_URL=http://evolution:8080
EVOLUTION_API_KEY=REPLACE_ME_com_openssl_rand_hex_32
EVO_DB_PASSWORD=REPLACE_ME_com_openssl_rand_hex_24

# --- Meta CAPI (opcional, so se usar) ---
META_VERIFY_TOKEN=REPLACE_ME_com_openssl_rand_hex_16

# --- Deepgram (opcional, transcricao de audio) ---
DEEPGRAM_API_KEY=
